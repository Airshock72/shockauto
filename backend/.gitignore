# The repo root .gitignore ignores *.sln (frontend tooling) - keep the backend solution tracked
!*.sln

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.dll
*.exe
*.pdb

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio
.vs/
*.rsuser
*.cache
*.VisualState.xml
TestResult.xml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# Test results / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
TestResults/

# Secrets and local configuration
appsettings.Development.json
appsettings.Local.json
*.local.json
.env
.env.*
secrets.json
*.pfx
*.p12
*.key

# Local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.mdf
*.ldf

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini